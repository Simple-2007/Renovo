# Скопируйте этот файл в .env и подставьте свои значения.

# COM-порт контроллера. Пусто — определить автоматически.
SERIAL_PORT=COM4

# Скорость порта. Должна совпадать с прошивкой:
#   9600   — WeatherStation (прошивка с SD/RTC)
#   115200 — renovo_temp
BAUD=9600

# Приёмник на сервере.
API_URL=https://renovo.leikom.ru/api/v1/readings

# Ключ устройства из админки: /admin/telemetry/device/
DEVICE_KEY=

# Ставить часы контроллера по времени этого ПК при подключении.
# Имеет смысл только при установленном DS3231; без него безвредно.
SYNC_RTC=1

HTTP_TIMEOUT=10
